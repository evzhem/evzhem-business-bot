# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789
BOT_USERNAME=evzhem_business_bot

# Admin Telegram IDs (comma-separated)
ADMIN_IDS=[123456789]

# Database (SQLite by default, or postgresql+asyncpg://user:pass@localhost:5432/bot_db)
DATABASE_URL=sqlite+aiosqlite:///./business_bot.db
REDIS_URL=redis://localhost:6379/0

# WebApp & Server Settings
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8000
WEBAPP_BASE_URL=https://your-domain.com

# AI Auto-Responder (OpenAI or OpenRouter)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Telegram Stars Pricing (XTR)
PREMIUM_PRICE_1M=150
PREMIUM_PRICE_3M=390
PREMIUM_PRICE_LIFETIME=990
